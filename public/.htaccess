# Optional Apache/Hostinger asset caching rules.
# Applied only when Apache serves the /public assets and honors .htaccess.
# Node/Astro standalone and nginx/CDN setups must configure caching at their own edge.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|gif|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^site-interactions\.js$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
