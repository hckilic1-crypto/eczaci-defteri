---
import Base from '../../layouts/Base.astro';import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('posts',p=>!p.data.draft);return posts.map(post=>({params:{slug:post.id.replace(/\.mdoc$/,'')},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);const d=post.data;
const date=(x)=>new Intl.DateTimeFormat('tr-TR',{day:'2-digit',month:'long',year:'numeric'}).format(x);
---
<Base title={d.seoTitle||`${d.title} | Eczacı Defteri`} description={d.seoDescription||d.excerpt}><article class="shell article"><header class="article-head"><div class="meta"><span class="pill">{d.category.replaceAll('-',' ')}</span><span>{date(d.publishedAt)}</span><span>·</span><span>{d.readingTime} dk okuma</span></div><h1>{d.title}</h1><p class="dek">{d.excerpt}</p>{d.updatedAt && <p class="meta">Son güncelleme: {date(d.updatedAt)}</p>}</header><div class="article-body"><Content /></div>{d.references?.length>0 && <section class="legalbox"><strong>Kaynakça</strong><ol>{d.references.map(r=><li><a href={r.url} rel="noreferrer">{r.label}</a></li>)}</ol></section>}<aside class="authorbox"><div class="kicker">Yazar künyesi</div><strong>Eczacı H.K.</strong><p>Eczacı Defteri’nin kurucusu ve editörü. İlaç, sağlık okuryazarlığı ve eczacılık pratiği üzerine kaynak temelli içerikler hazırlar.</p></aside><aside class="legalbox"><strong>Tıbbi sorumluluk notu</strong><br>Bu içerik genel bilgilendirme içindir; tanı, reçete veya kişiye özel tedavi önerisi değildir. İlaç değişikliği veya tedavi kararı için hekiminiz ve eczacınızla görüşün.</aside></article></Base>
