---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { topicHubs } from '../../lib/topic-hubs';
import { resourcesForHub } from '../../lib/topic-resources';
export function getStaticPaths(){return topicHubs.map(hub=>({params:{slug:hub.slug},props:{hub}}))}
const {hub}=Astro.props;
const data=await resourcesForHub(hub);
const sections=[
 {key:'yazilar',title:'Makaleler',note:'Konuya bütüncül yaklaşım',items:data.posts},
 {key:'atlas',title:'Bileşen Atlası',note:'Mekanizmalar ve klinik kanıt',items:data.atlas},
 {key:'rehber',title:'Etiket Okuma',note:'Günlük porsiyon, içerik ve güvenlilik',items:data.guides},
 {key:'sozluk',title:'Sözlük',note:'Temel kavramlar',items:data.glossary}
].filter(x=>x.items.length);
const url='https://eczacidefteri.com/konular/'+hub.slug;
const schema={
 '@context':'https://schema.org',
 '@graph':[
 {'@type':'CollectionPage',name:hub.title,description:hub.short,url,inLanguage:'tr-TR',
  mainEntity:{'@type':'ItemList',itemListElement:sections.flatMap(x=>x.items).map((x,i)=>({
   '@type':'ListItem',position:i+1,name:x.title,url:'https://eczacidefteri.com'+x.href}))}},
 {'@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Anasayfa',item:'https://eczacidefteri.com/'},
  {'@type':'ListItem',position:2,name:'Konular',item:'https://eczacidefteri.com/konular'},
  {'@type':'ListItem',position:3,name:hub.title,item:url}]}
 ]
};
const otherHubs=topicHubs.filter(x=>x.slug!==hub.slug);
---
<Base title={hub.title+' | Eczacı Defteri'} description={hub.short} structuredData={schema}>
 <article class="shell ed-dossier-detail">
   <nav class="article-breadcrumbs" aria-label="Gezinme yolu"><a href="/">Anasayfa</a><span class="article-crumb-sep">/</span><a href="/konular">Konular</a><span class="article-crumb-sep">/</span><span aria-current="page">{hub.title}</span></nav>
   <header class="ed-dossier-detail-header">
     <div>
       <span class="ed-overline">Konu dosyası <span class="ed-meta-separator">/</span> {hub.eyebrow.replaceAll(' / ', ' · ')}</span>
       <h1>{hub.title}</h1>
       <p>{hub.short}</p>
     </div>
     <div class="ed-dossier-folio" aria-hidden="true"><span>ED.</span><strong>{hub.mark}</strong><small>Konular</small></div>
   </header>
   <div class="ed-dossier-body">
     <div class="ed-dossier-article">
       <section class="ed-dossier-prose" id="genel-bakis">
         <div class="ed-article-kicker">Genel bakış</div>
         {hub.intro.map((paragraph,i)=><p class:list={[{'ed-dossier-first':i===0}]}>{paragraph}</p>)}
       </section>
       <section class="ed-dossier-method" id="okuma-notlari">
         <h2>Okumaya başlamadan</h2>
         <dl>{hub.steps.map(x=><div><dt>{x.title}</dt><dd>{x.text}</dd></div>)}</dl>
       </section>
       {sections.map(section=><section class="ed-dossier-references" id={section.key} aria-labelledby={'head-'+section.key}>
         <div class="ed-ref-head"><h2 id={'head-'+section.key}>{section.title}</h2><p>{section.note}</p></div>
         <ol class="ed-reference-list">{section.items.map((item,i)=><li>
           <a href={item.href}>
             <span class="ed-reference-index">{String(i+1).padStart(2,'0')}</span>
             <span class="ed-reference-description"><strong>{item.title}</strong><span>{item.excerpt}</span></span>
             <span class="ed-reference-open" aria-hidden="true">↗</span>
           </a>
         </li>)}</ol>
       </section>)}
       <div class="ed-dossier-disclaimer">Bu okuma dosyası genel bilgilendirme içindir. Tedavi kararı, kontrendikasyonlar ve hasta özelindeki riskler kişisel değerlendirme gerektirir. Bağlantılı yazıların kaynakçalarını kendi sayfalarında bulabilirsiniz.</div>
     </div>
     <aside class="ed-dossier-margin" aria-label="Dosyada gezin">
       <div class="ed-margin-head">BU DOSYADA</div>
       <nav aria-label="Sayfa içeriği">
         <a href="#genel-bakis">Genel bakış</a>
         <a href="#okuma-notlari">Okuma notları</a>
         {sections.map(x=><a href={'#'+x.key}>{x.title} <span>{x.items.length}</span></a>)}
       </nav>
       <div class="ed-margin-note"><span>KAYNAK YÖNTEMİ</span><p>Bir kavramın biyolojik işlevi ile insanlarda gösterilmiş klinik yararı aynı kanıt düzeyi değildir.</p></div>
     </aside>
   </div>
   <footer class="ed-dossier-next">
     <h2>Diğer konu dosyaları</h2>
     <div>{otherHubs.map(x=><a href={'/konular/'+x.slug}>{x.title}<span aria-hidden="true">↗</span></a>)}</div>
   </footer>
 </article>
</Base>
