---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const slugOf = item => item.id.replace(/\.json$/, '').split('/').pop();
export async function getStaticPaths() {
  const all = await getCollection('categories');
  return all.map(cat => ({params:{slug:cat.id.replace(/\.json$/, '').split('/').pop()},props:{cat}}));
}
const { cat } = Astro.props;
const categories = await getCollection('categories');
const slug = slugOf(cat);
const children = categories.filter(c => c.data.parent === slug)
  .sort((a,b) => (a.data.order ?? 100) - (b.data.order ?? 100) || a.data.name.localeCompare(b.data.name,'tr'));
const visible = new Set([slug, ...children.map(slugOf)]);
const posts = (await getCollection('posts', p => !p.data.draft && visible.has(p.data.category)))
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const parent = categories.find(c => slugOf(c) === cat.data.parent);
const crumbs = [
  {title:'Anasayfa',href:'/'},
  ...(parent ? [{title:parent.data.name,href:'/kategori/' + slugOf(parent)}] : []),
  {title:cat.data.name,href:'/kategori/' + slug}
];
const structuredData = {
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  itemListElement:crumbs.map((c,i)=>({
    '@type':'ListItem',position:i+1,name:c.title,item:new URL(c.href,'https://eczacidefteri.com').href
  }))
};
---
<Base title={cat.data.name + ' | Eczacı Defteri'} description={cat.data.description || ''} noindex={posts.length === 0} structuredData={structuredData}>
  <div class="shell journal-archive">
    <nav class="article-breadcrumbs" aria-label="Gezinme yolu">
      {crumbs.map((c,i)=>(
        <span>{i > 0 && <span class="article-crumb-sep">/</span>}{i === crumbs.length - 1 ? <span aria-current="page">{c.title}</span> : <a href={c.href}>{c.title}</a>}</span>
      ))}
    </nav>
    <header class="journal-category-header">
      <span class="journal-eyebrow">KONU DOSYASI <span aria-hidden="true">/</span> ECZACI DEFTERİ</span>
      <h1>{cat.data.name}</h1>
      {cat.data.description && <p>{cat.data.description}</p>}
      <div class="journal-archive-count">{posts.length} yazı {children.length > 0 && <span>· {children.length} alt kategori</span>}</div>
    </header>

    {children.length > 0 && (
      <nav class="journal-subtopics" aria-label="Alt kategoriler">
        <span>ALT KATEGORİLER</span>
        <div>{children.map(child => <a href={'/kategori/' + slugOf(child)}>{child.data.name} <span aria-hidden="true">↗</span></a>)}</div>
      </nav>
    )}

    <section class="journal-category-articles" aria-label="Kategori yazıları">
      <div class="journal-section-heading">
        <div><span class="journal-eyebrow">BU KONUDA</span><h2>Yazılar</h2></div>
        <a href="/yazilar">Tüm arşiv ↗</a>
      </div>
      {posts.length > 0 ? (
        <div class="grid journal-post-grid">{posts.map(post => <PostCard post={post} />)}</div>
      ) : (
        <div class="journal-empty">
          <p>Bu konuda henüz yayımlanmış yazı bulunmuyor.</p>
          <a href="/yazilar">Diğer yazılara göz at ↗</a>
        </div>
      )}
    </section>
  </div>
</Base>
