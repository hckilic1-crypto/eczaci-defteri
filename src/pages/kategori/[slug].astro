---
import Base from '../../layouts/Base.astro';import PostCard from '../../components/PostCard.astro';import {getCollection} from 'astro:content';
export async function getStaticPaths(){const cats=await getCollection('categories');return cats.map(cat=>({params:{slug:cat.id.replace(/\.json$/,'')},props:{cat}}));}
const {cat}=Astro.props;const posts=(await getCollection('posts',p=>!p.data.draft&&p.data.category===cat.id.replace(/\.json$/,''))).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
---
<Base title={`${cat.data.name} | Eczacı Defteri`} description={cat.data.description}><section class="shell page-head"><div class="kicker">Kategori</div><h1>{cat.data.name}</h1><p>{cat.data.description}</p></section><section class="shell grid">{posts.map(p=><PostCard post={p}/>)}</section></Base>
