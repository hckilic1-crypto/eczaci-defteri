---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { glossarySlug, articleSlug, relatedPostsForTerm, relatedTermsForTerm } from '../../lib/glossary-related';

export async function getStaticPaths(){
  const terms=await getCollection('glossary', t=>!t.data.draft);
  return terms.map(term=>({
    params:{slug:term.id.replace(/\.json$/,'').split('/').pop()},
    props:{term}
  }));
}
const {term}=Astro.props;
const d=term.data;
const slug=term.id.replace(/\.json$/,'').split('/').pop();
const glossaryEntries = await getCollection('glossary', t => !t.data.draft);
const others = relatedTermsForTerm(term, glossaryEntries);
const relatedArticles = relatedPostsForTerm(term, await getCollection('posts', p => !p.data.draft));
const atlasMatches = await getCollection('atlas', item => !item.data.draft && item.data.glossarySlug === slug);
const structuredData={
  '@context':'https://schema.org',
  '@type':'DefinedTerm',
  name:d.name,
  description:d.definition,
  inDefinedTermSet:'https://eczacidefteri.com/sozluk',
  url:'https://eczacidefteri.com/sozluk/'+slug,
  ...(d.sourceUrl ? {citation:d.sourceUrl} : {})
};
---
<Base
  title={d.name+' Nedir? | Eczacılık Sözlüğü - Eczacı Defteri'}
  description={d.definition}
  structuredData={structuredData}
>
  <article class="shell glossary-entry-page">
    <nav class="article-breadcrumbs" aria-label="Gezinme yolu">
      <a href="/">Anasayfa</a><span class="article-crumb-sep">/</span><a href="/sozluk">Sözlük</a><span class="article-crumb-sep">/</span><span aria-current="page">{d.name}</span>
    </nav>
    <header class="glossary-entry-head">
      <span class="journal-eyebrow">ECZACILIK SÖZLÜĞÜ <span aria-hidden="true">/</span> {d.category}</span>
      <h1>{d.name}<span> nedir?</span></h1>
      <p>{d.definition}</p>
    </header>
    <div class="glossary-entry-body">
      {d.explanation && (
        <section aria-labelledby="glossary-detail-label">
          <span class="glossary-detail-kicker" id="glossary-detail-label">ECZACININ NOTU</span>
          <p>{d.explanation}</p>
        </section>
      )}
      {d.sourceUrl && (
        <section class="glossary-entry-source" aria-labelledby="glossary-source-label">
          <span class="glossary-detail-kicker" id="glossary-source-label">KAYNAK</span>
          <a href={d.sourceUrl} rel="noopener noreferrer" target="_blank">{d.sourceLabel || 'İlgili bilimsel kaynak'} <span aria-hidden="true">↗</span></a>
        </section>
      )}
    </div>
    {atlasMatches.length > 0 && (
      <nav class="glossary-atlas-bridge" aria-label="Bileşen atlasında detaylı inceleme">
        <span class="library-section-label">İLGİLİ BİLEŞEN DOSYASI</span>
        <h2>Tanımdan ayrıntıya</h2>
        <p>Etki mekanizması, klinik bağlam, etkileşim ve etiket okuma notları için atlas dosyasına geçin.</p>
        {atlasMatches.map(item => <a href={'/atlas/'+item.id.replace(/\.json$/,'')}>{item.data.name} — Bileşen Atlası ↗</a>)}
      </nav>
    )}
    <nav class="glossary-entry-back"><a href="/sozluk">← Sözlükteki tüm terimler</a></nav>
    {relatedArticles.length > 0 && (
      <section class="glossary-entry-articles" aria-labelledby="glossary-article-heading">
        <div class="journal-section-heading"><div><span class="journal-eyebrow">DAHA FAZLA OKU</span><h2 id="glossary-article-heading">İlgili yazılar</h2></div></div>
        <div class="glossary-article-list">
          {relatedArticles.map(post => (
            <a href={'/yazi/' + articleSlug(post)}>
              <strong>{post.data.title}</strong>
              <span>{post.data.excerpt}</span>
              <small>Yazıyı oku ↗</small>
            </a>
          ))}
        </div>
      </section>
    )}
    {others.length > 0 && (
      <aside class="glossary-entry-related">
        <div class="journal-section-heading"><div><span class="journal-eyebrow">BAĞLANTILI KAVRAMLAR</span><h2>İlgili terimler</h2></div></div>
        <div>{others.map(t => <a href={'/sozluk/' + glossarySlug(t)}>{t.data.name}<span aria-hidden="true">↗</span></a>)}</div>
      </aside>
    )}
  </article>
</Base>
