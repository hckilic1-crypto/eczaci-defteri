---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { glossarySlug, relatedPostsForTerm, relatedTermsForTerm } from '../../lib/glossary-related';
import ContentConnections from '../../components/ContentConnections.astro';
import TopicBacklinks from '../../components/TopicBacklinks.astro';
import { hubsForContent } from '../../lib/topic-hubs';
import { atlasForTerm, guidesForTerm, link, group } from '../../lib/content-connections';

export async function getStaticPaths(){
  const terms=await getCollection('glossary', t=>!t.data.draft);
  return terms.map(term=>({
    params:{slug:term.id.replace(/\.json$/,'').split('/').pop()},
    props:{term}
  }));
}
const {term}=Astro.props;
const d=term.data;
const slug=term.id.replace(/\.json$/,'').split('/').pop();
const relevantHubs=hubsForContent('glossary',slug);
const glossaryEntries = await getCollection('glossary', t => !t.data.draft);
const others = relatedTermsForTerm(term, glossaryEntries);
const relatedArticles = relatedPostsForTerm(term, await getCollection('posts', p => !p.data.draft));
const atlases = await getCollection('atlas', item => !item.data.draft);
const guides = await getCollection('labelGuides', item => !item.data.draft);
const relatedAtlas = atlasForTerm(term,atlases,3);
const relatedGuides = guidesForTerm(term,atlases,guides,3);
const readingGroups = [
  group('01','Bileşen Atlası',relatedAtlas.map(link.atlas)),
  group('02','Blog yazıları',relatedArticles.map(link.post)),
  group('03','Etiket Okuma Rehberi',relatedGuides.map(link.guide))
];
const termUrl = 'https://eczacidefteri.com/sozluk/' + slug;
const structuredData = {
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'DefinedTerm',name:d.name,description:d.definition,
      inDefinedTermSet:'https://eczacidefteri.com/sozluk',
      url:termUrl,...(d.sourceUrl ? {citation:d.sourceUrl} : {})},
    {'@type':'BreadcrumbList',itemListElement:[
      {'@type':'ListItem',position:1,name:'Anasayfa',item:'https://eczacidefteri.com/'},
      {'@type':'ListItem',position:2,name:'Sözlük',item:'https://eczacidefteri.com/sozluk'},
      {'@type':'ListItem',position:3,name:d.name,item:termUrl}
    ]}
  ]
};
---
<Base
  title={d.name+' Nedir? | Eczacı Defteri'}
  description={d.definition}
  structuredData={structuredData}
>
  <article class="shell glossary-entry-page">
    <nav class="article-breadcrumbs" aria-label="Gezinme yolu">
      <a href="/">Anasayfa</a><span class="article-crumb-sep">/</span><a href="/sozluk">Sözlük</a><span class="article-crumb-sep">/</span><span aria-current="page">{d.name}</span>
    </nav>
    <header class="glossary-entry-head">
      <span class="journal-eyebrow">ECZACILIK SÖZLÜĞÜ <span aria-hidden="true">/</span> {d.category}</span>
      <h1>{d.name}<span> nedir?</span></h1>
      <p>{d.definition}</p>
    </header>
    <div class="glossary-entry-body">
      {d.explanation && (
        <section aria-labelledby="glossary-detail-label">
          <span class="glossary-detail-kicker" id="glossary-detail-label">ECZACININ NOTU</span>
          <p>{d.explanation}</p>
        </section>
      )}
      {d.sourceUrl && (
        <section class="glossary-entry-source" aria-labelledby="glossary-source-label">
          <span class="glossary-detail-kicker" id="glossary-source-label">KAYNAK</span>
          <a href={d.sourceUrl} rel="noopener noreferrer" target="_blank">{d.sourceLabel || 'İlgili bilimsel kaynak'} <span aria-hidden="true">↗</span></a>
        </section>
      )}
    </div>
    <ContentConnections groups={readingGroups} heading="Bu kavramı daha ayrıntılı keşfedin" />
    <TopicBacklinks hubs={relevantHubs} />
    <nav class="glossary-entry-back"><a href="/sozluk">← Sözlükteki tüm terimler</a></nav>
    {others.length > 0 && (
      <aside class="glossary-entry-related">
        <div class="journal-section-heading"><div><span class="journal-eyebrow">BAĞLANTILI KAVRAMLAR</span><h2>İlgili terimler</h2></div></div>
        <div>{others.map(t => <a href={'/sozluk/' + glossarySlug(t)}>{t.data.name}<span aria-hidden="true">↗</span></a>)}</div>
      </aside>
    )}
  </article>
</Base>
