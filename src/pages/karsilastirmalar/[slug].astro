---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){
 const entries=await getCollection('comparisons',x=>!x.data.draft);
 return entries.map(item=>({params:{slug:item.id.replace(/\.json$/,'')},props:{item}}));
}
const {item}=Astro.props;const d=item.data;
const schema={'@context':'https://schema.org','@type':'Article',headline:d.title,description:d.summary,mainEntityOfPage:'https://eczacidefteri.com/karsilastirmalar/'+item.id.replace(/\.json$/,'')};
---
<Base title={d.title+' | Karşılaştırma Kütüphanesi'} description={d.summary} structuredData={schema}>
 <article class="shell library-detail">
  <nav class="article-breadcrumbs" aria-label="Gezinme yolu"><a href="/">Anasayfa</a><span class="article-crumb-sep">/</span><a href="/karsilastirmalar">Karşılaştırmalar</a><span class="article-crumb-sep">/</span><span aria-current="page">{d.title}</span></nav>
  <header class="library-detail-head"><span class="library-index-kicker">KARŞILAŞTIRMA / {d.area}</span><h1>{d.title}</h1><p>{d.summary}</p></header>
  <div class="library-reading">
   <div class="library-versus"><div><small>01 / İLK SEÇENEK</small><h2>{d.leftName}</h2><p>{d.leftDetail}</p>{d.leftAtlasSlug && <a href={'/atlas/'+d.leftAtlasSlug}>Bileşen dosyası ↗</a>}</div><div><small>02 / İKİNCİ SEÇENEK</small><h2>{d.rightName}</h2><p>{d.rightDetail}</p>{d.rightAtlasSlug && <a href={'/atlas/'+d.rightAtlasSlug}>Bileşen dosyası ↗</a>}</div></div>
   <section><span class="library-section-label">03 / AYIRICI NOKTA</span><h2>Temel fark nedir?</h2><p>{d.keyDifference}</p></section>
   <section><span class="library-section-label">04 / SEÇİM BAĞLAMI</span><h2>Hangi koşullarda değerlendirilir?</h2><p>{d.practical}</p></section>
   <section><span class="library-section-label">05 / GÜVENLİLİK</span><h2>Nelere dikkat edilmeli?</h2><p>{d.warning}</p></section>
   <section><span class="library-section-label">06 / KAYNAK</span><h2>Referans</h2><a class="library-source" href={d.sourceUrl} target="_blank" rel="noopener noreferrer">{d.sourceLabel} ↗</a></section>
  </div>
  <aside class="library-disclaimer">Karşılaştırma klinik üstünlük, belirli bir kişiye uygunluk veya tedavi tavsiyesi anlamına gelmez; karar hastanın koşullarına ve güncel ürün bilgisine dayanır.</aside>
 </article>
</Base>