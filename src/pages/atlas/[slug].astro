---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import ContentConnections from '../../components/ContentConnections.astro';
import { postsForAtlas, termsForAtlas, guidesForAtlas, link, group } from '../../lib/content-connections';
export async function getStaticPaths(){
  const items=await getCollection('atlas', x=>!x.data.draft);
  return items.map(item=>({params:{slug:item.id.replace(/\.json$/,'')},props:{item}}));
}
const {item}=Astro.props;
const d=item.data;
const termSlug=item.id.replace(/\.json$/,'');
const [guides,posts,terms] = await Promise.all([
  getCollection('labelGuides', x => !x.data.draft),
  getCollection('posts', x => !x.data.draft),
  getCollection('glossary', x => !x.data.draft)
]);
const connected = [
  group('01','Sözlükteki kavramlar', termsForAtlas(item,terms,5).map(link.term)),
  group('02','Blog yazıları', postsForAtlas(item,posts,3).map(link.post)),
  group('03','Etiket Okuma Rehberi', guidesForAtlas(item,guides,4).map(link.guide))
];
const entryUrl = 'https://eczacidefteri.com/atlas/'+termSlug;
const schema={
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'Article',headline:d.name+' — Bileşen Atlası',
      description:d.summary,mainEntityOfPage:entryUrl,inLanguage:'tr-TR',
      publisher:{'@type':'Organization',name:'Eczacı Defteri',url:'https://eczacidefteri.com/'},
      citation:d.sourceUrl},
    {'@type':'BreadcrumbList',itemListElement:[
      {'@type':'ListItem',position:1,name:'Anasayfa',item:'https://eczacidefteri.com/'},
      {'@type':'ListItem',position:2,name:'Bileşen Atlası',item:'https://eczacidefteri.com/atlas'},
      {'@type':'ListItem',position:3,name:d.name,item:entryUrl}
    ]}
  ]
};
---
<Base title={d.name+' | Bileşen Atlası - Eczacı Defteri'} description={d.summary} type="article" structuredData={schema}>
  <article class="shell library-detail">
    <nav class="article-breadcrumbs" aria-label="Gezinme yolu"><a href="/">Anasayfa</a><span class="article-crumb-sep">/</span><a href="/atlas">Bileşen Atlası</a><span class="article-crumb-sep">/</span><span aria-current="page">{d.name}</span></nav>
    <header class="library-detail-head">
      <span class="library-index-kicker">BİLEŞEN ATLASI / {d.category.toLocaleUpperCase('tr-TR')}</span>
      <h1>{d.name}</h1><p>{d.summary}</p>
      <div class="library-head-meta"><span>MEKANİZMA</span><span>KANIT</span><span>GÜVENLİLİK</span></div>
    </header>
    {(d.chemicalIdentity || d.molecularFormula) && (
      <section class="atlas-chemistry" aria-label="Kimyasal kimlik">
        <div class="atlas-chemistry-heading"><span class="library-section-label">KİMYASAL KİMLİK KARTI</span><span>ECZACI DEFTERİ / REFERANS</span></div>
        <div class="atlas-chemistry-grid">
          <div><small>MOLEKÜL / FORMÜL</small><strong class="atlas-formula">{d.molecularFormula || 'Tek moleküler formül yok'}</strong></div>
          <div><small>KİMYASAL SINIF</small><strong>{d.chemicalClass || 'Bileşik / preparat grubu'}</strong></div>
        </div>
        {d.chemicalIdentity && <p>{d.chemicalIdentity}</p>}
        {d.sourceChemUrl && <a class="atlas-chem-link" href={d.sourceChemUrl} target="_blank" rel="noopener noreferrer">Molekül ve yapı verisini incele ↗</a>}
      </section>
    )}
    <div class="library-detail-layout">
      <div class="library-detail-content">
        <section id="mekanizma"><span class="library-section-label">01 / BİLEŞENİN YAPISI</span><h2>Nedir, nasıl çalışır?</h2><p>{d.mechanism}</p></section>
        <section id="klinik"><span class="library-section-label">02 / KLİNİK KULLANIM</span><h2>Hangi amaçlarla inceleniyor?</h2><p>{d.clinical}</p></section>
        <section id="kanit"><span class="library-section-label">03 / KANITIN GÜCÜ</span><h2>Araştırmalar ne söylüyor?</h2><p>{d.evidence}</p></section>
        <section id="doz"><span class="library-section-label">04 / DOZ BAĞLAMI</span><h2>Doz ve formülasyon</h2><p>{d.dose}</p></section>
        <section id="guvenlilik"><span class="library-section-label">05 / GÜVENLİLİK</span><h2>Uyarılar ve kontrendikasyonlar</h2><p>{d.warnings}</p></section>
        <section id="etkilesimler"><span class="library-section-label">06 / BİRLİKTE KULLANIM</span><h2>İlaç etkileşimleri</h2><p>{d.interactions}</p></section>
        <section id="etiket"><span class="library-section-label">07 / ECZACININ NOTU</span><h2>Etikette neye bakmalı?</h2><p>{d.labelTip}</p></section>
        {d.formulations && <section id="formlar"><span class="library-section-label">08 / HAZIRLAMA VE FORM</span><h2>Hangi form fark yaratır?</h2><p>{d.formulations}</p></section>}
        {d.studiedPopulation && <section id="populasyon"><span class="library-section-label">09 / ARAŞTIRMA GRUPLARI</span><h2>Kimlerde araştırıldı?</h2><p>{d.studiedPopulation}</p></section>}
        {d.pharmacistChecklist && <section id="eczaci-kontrol"><span class="library-section-label">10 / ECZACI KONTROL LİSTESİ</span><h2>Değerlendirilmesi gereken noktalar</h2><p>{d.pharmacistChecklist}</p></section>}
        {d.practicalLimits && <section id="sinirlar"><span class="library-section-label">11 / YORUMLAMA SINIRLARI</span><h2>Hangi sonuç çıkarılamaz?</h2><p>{d.practicalLimits}</p></section>}
        <section id="kaynak"><span class="library-section-label">12 / BİLİMSEL KAYNAK</span><h2>Kaynak</h2><a class="library-source" href={d.sourceUrl} rel="noopener noreferrer" target="_blank">{d.sourceLabel} ↗</a></section>
      </div>
      <aside class="library-detail-aside">
        <div class="library-aside-label">BU DOSYADA</div>
        <a href="#mekanizma">01 &nbsp; Mekanizma</a>
        <a href="#klinik">02 &nbsp; Klinik kullanım</a>
        <a href="#kanit">03 &nbsp; Kanıt</a>
        <a href="#doz">04 &nbsp; Doz bağlamı</a>
        <a href="#guvenlilik">05 &nbsp; Güvenlilik</a>
        <a href="#etkilesimler">06 &nbsp; Etkileşimler</a>
        <a href="#etiket">07 &nbsp; Etiket</a>
        {d.formulations && <a href="#formlar">08 &nbsp; Formlar</a>}
        {d.studiedPopulation && <a href="#populasyon">09 &nbsp; Çalışılan gruplar</a>}
        {d.pharmacistChecklist && <a href="#eczaci-kontrol">10 &nbsp; Kontrol listesi</a>}
        {d.practicalLimits && <a href="#sinirlar">11 &nbsp; Sınırlılıklar</a>}
        <a href="#kaynak">12 &nbsp; Kaynak</a>
      </aside>
    </div>
    <ContentConnections groups={connected} heading="Bileşenle bağlantılı içerikler" />
    <aside class="library-disclaimer">Bu sayfa kişisel tedavi, doz veya ürün önerisi değildir. Kullanım kararı için güncel kısa ürün bilgisi, özel hasta koşulları ve klinik değerlendirme esas alınır.</aside>
  </article>
</Base>