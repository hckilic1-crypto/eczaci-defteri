---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('atlas', item => !item.data.draft))
  .sort((a,b) => a.data.name.localeCompare(b.data.name, 'tr'));
const categories = [...new Set(entries.map(item => item.data.category))].sort((a,b)=>a.localeCompare(b,'tr'));
const slug = (item) => item.id.replace(/\.json$/, '').split('/').pop();
const structuredData = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Bileşen Atlası',
  description:'Takviye ve dermokozmetik bileşenleri: etki mekanizması, bilimsel kanıt, etkileşim ve güvenlilik dosyaları.',
  url:'https://eczacidefteri.com/atlas'
};
---
<Base title="Bileşen Atlası | Eczacı Defteri" description="Takviye ve dermokozmetik bileşenleri: etki mekanizması, bilimsel kanıt, etkileşim ve güvenlilik dosyaları." structuredData={structuredData}>
  <div class="shell library-index">
    <nav class="article-breadcrumbs" aria-label="Gezinme yolu"><a href="/">Anasayfa</a><span class="article-crumb-sep">/</span><span aria-current="page">Bileşen Atlası</span></nav>
    <header class="library-head">
      <div class="library-index-kicker">ECZACI DEFTERİ / BİLEŞEN KÜTÜPHANESİ</div>
      <h1>Bileşen Atlası<span class="library-head-period">.</span></h1>
      <p>Takviyeleri ve dermokozmetik bileşenlerini; mekanizma, klinik bağlam, güvenlilik, etkileşim ve etiket bilgileriyle keşfedin.</p>
      <div class="library-head-meta"><span>{entries.length} kayıt</span><span>30 başlangıç bileşeni</span><span>Kaynak temelli</span></div>
    </header>
    <section class="library-browser" aria-label="Kütüphanede ara ve filtrele">
      <label class="library-search"><span class="sr-only">Kaydın adını ara</span><input id="library-query" type="search" placeholder="Konu veya bileşen ara..." autocomplete="off" /></label>
      <label class="library-category"><span class="sr-only">Konu seç</span><select id="library-category"><option value="">Tüm konular</option>{categories.map(c => <option value={c}>{c}</option>)}</select></label>
    </section>
    <div class="library-results" id="library-results" aria-live="polite">{entries.length} dosya</div>
    <div class="library-directory" id="library-directory">
      {entries.map((item,i) => <a class="library-directory-item" href={'/atlas/'+slug(item)} data-category={item.data.category} data-search={(item.data.name+' '+item.data.summary+' '+item.data.category).toLocaleLowerCase('tr-TR')}>
        <span class="library-directory-number">{String(i+1).padStart(2,'0')}</span>
        <span class="library-directory-copy"><small>{item.data.category}</small><strong>{item.data.name}</strong><span>{item.data.summary}</span></span>
        <span class="library-directory-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
    <p id="library-empty" class="library-empty" hidden>Eşleşen dosya yok. Aramayı veya kategoriyi değiştirin.</p>
    <aside class="library-disclaimer">İçerikler genel bilgilendirme amaçlıdır. Belirli bir preparatın ruhsatlı kullanım alanı, kontrendikasyonları ve ilaç etkileşimleri için güncel ürün bilgisi ve sağlık profesyoneli değerlendirmesi esastır.</aside>
  </div>
  <script>
    const query = document.querySelector<HTMLInputElement>('#library-query');
    const category = document.querySelector<HTMLSelectElement>('#library-category');
    const items = [...document.querySelectorAll<HTMLElement>('.library-directory-item')];
    const count = document.querySelector<HTMLElement>('#library-results');
    const empty = document.querySelector<HTMLElement>('#library-empty');
    const normalize = (s: string) => s.toLocaleLowerCase('tr-TR').replace(/ı/g,'i').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
    const filter = () => {
      const q = normalize(query?.value.trim() || '');
      const cat = category?.value || '';
      let shown = 0;
      for (const item of items) {
        const match = (!q || normalize(item.dataset.search || '').includes(q)) && (!cat || item.dataset.category === cat);
        item.hidden = !match;
        if (match) shown++;
      }
      if (count) count.textContent = shown + ' / ' + items.length + ' dosya';
      if (empty) empty.hidden = shown !== 0;
    };
    query?.addEventListener('input',filter);
    category?.addEventListener('change',filter);
  </script>
</Base>
