---
export const prerender = true;
import Base from '../layouts/Base.astro';
import NotebookVisual from '../components/NotebookVisual.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { topicHubs } from '../lib/topic-hubs';

const posts = (await getCollection('posts', p => !p.data.draft))
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const categories = (await getCollection('categories'))
  .sort((a,b) => (a.data.order ?? 100) - (b.data.order ?? 100) || a.data.name.localeCompare(b.data.name,'tr'));
const topCategories = categories.filter(c => !c.data.parent);
const glossaryCount = (await getCollection('glossary', t => !t.data.draft)).length;
const atlasCount = (await getCollection('atlas', t => !t.data.draft)).length;
const featured = posts.find(p => p.data.featured) ?? posts[0];
const latest = posts.filter(p => p.id !== featured?.id);
const leadAside = latest.slice(0,2);
const morePosts = latest.slice(2,11);
const slugOf = p => p.id.replace(/\.mdoc$/, '');
const catLabel = p => categories.find(c => c.id.replace(/\.json$/,'').split('/').pop() === p.data.category)?.data.name || p.data.category.replaceAll('-',' ');
const dateLabel = p => new Intl.DateTimeFormat('tr-TR',{day:'numeric',month:'long',year:'numeric'}).format(p.data.publishedAt);
const structuredData = {
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'WebSite','@id':'https://eczacidefteri.com/#website',
      name:'Eczacı Defteri',url:'https://eczacidefteri.com/',
      inLanguage:'tr-TR',publisher:{'@id':'https://eczacidefteri.com/#organization'}},
    {'@type':'Organization','@id':'https://eczacidefteri.com/#organization',
      name:'Eczacı Defteri',url:'https://eczacidefteri.com/'}
  ]
};
---

<Base
  title="Eczacı Defteri | Eczacılık, Takviyeler ve Dermokozmetik"
  description="Eczacılık, takviye edici gıdalar, dermokozmetik ve sağlık üzerine kaynaklı değerlendirmeler. Eczacı Defteri'nde bilgiyi kanıtıyla okuyun."
 preloadImage={featured?.data.coverImage || undefined}
 structuredData={structuredData}>
  <header class="shell journal-intro journal-intro--notebook">
    <div class="journal-intro-copy">
      <div class="journal-intro-label"><span class="journal-signet" aria-hidden="true">ED</span><span>BAĞIMSIZ ECZACILIK YAYINI</span></div>
      <h1>Sağlık bilgisini <em>kaynağından</em> okuyun.</h1>
      <p>İlaçları, takviyeleri ve cilt bakımını; kullanım alanları, bilimsel kanıtlar ve eczacılık pratiği üzerinden ele alan bir not defteri.</p>
      <div class="notebook-intro-signature" aria-hidden="true"><span>NOTLAR & KAYNAKLAR</span><i></i><span>01 / 03</span></div>
    </div>
    <NotebookVisual />
  </header>

  {featured && (
    <section class="shell journal-lead" aria-label="Öne çıkan ve yeni yazılar">
      <a class="journal-lead-story" href={'/yazi/' + slugOf(featured)}>
        <div class="journal-lead-image">
          {featured.data.coverImage
            ? <img src={featured.data.coverImage} alt="" width="1200" height="675" loading="eager" decoding="async" fetchpriority="high" />
            : <div class="journal-lead-fallback" aria-hidden="true">ECZACI DEFTERİ / DOSYA</div>}
        </div>
        <div class="journal-lead-caption">
          <span class="journal-eyebrow">ÖNE ÇIKAN YAZI <span class="journal-bullet">·</span> {catLabel(featured)}</span>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.excerpt}</p>
          <div class="journal-story-meta"><span>{dateLabel(featured)}</span><span>{featured.data.readingTime} dakika okuma</span><span class="journal-read-arrow">Yazıyı oku ↗</span></div>
        </div>
      </a>
      <aside class="journal-lead-aside" aria-label="Yeni yazılar">
        <div class="journal-aside-heading"><span>YENİ YAZILAR</span><a href="/yazilar">Tümü ↗</a></div>
        {leadAside.map((post,i) => (
          <a href={'/yazi/' + slugOf(post)} class="journal-aside-story">
            <span class="journal-aside-number">0{i+1}</span>
            <span class="journal-aside-copy"><small>{catLabel(post)} / {post.data.readingTime} dk</small><strong>{post.data.title}</strong><span>{post.data.excerpt}</span></span>
          </a>
        ))}
        <div class="journal-aside-signoff"><span class="journal-signet" aria-hidden="true">ED</span><p>Kaynağı gösteren, karşılaştıran ve anlaşılır kılan içerikler.</p></div>
      </aside>
    </section>
  )}

  <section class="shell ed-topic-home" aria-labelledby="ed-topic-home-head">
    <div class="journal-section-heading">
      <div><span class="journal-eyebrow">KONU DOSYALARI</span><h2 id="ed-topic-home-head">Derinlemesine okumalar</h2></div>
      <a href="/konular">Bütün konular <span aria-hidden="true">↗</span></a>
    </div>
    <p class="ed-topic-home-intro">Bir bileşenin nasıl çalıştığını, hangi insan çalışmalarında araştırıldığını ve hangi koşullarda dikkat gerektirdiğini birbirinden ayırıyoruz.</p>
    <div class="ed-topic-home-list">
      {topicHubs.map((hub,i)=><a href={'/konular/'+hub.slug}>
        <span>{String(i+1).padStart(2,'0')}</span>
        <strong>{hub.title}</strong>
        <small>{hub.short}</small>
        <span aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>

  <section class="shell library-home" aria-labelledby="library-home-title">
    <div class="journal-section-heading">
      <div><span class="journal-eyebrow">ECZACI DEFTERİ / REFERANS KÜTÜPHANESİ</span><h2 id="library-home-title">Bilginin izini sürün.</h2></div>
      <span class="library-home-index">DEFTER / 01—03</span>
    </div>
    <p class="library-home-intro">Bir terimden bilimsel çalışmaya, bir bileşenden güvenlilik değerlendirmesine. Konuları not defteri düzeninde birbirine bağladık.</p>
    <div class="notebook-section-folio notebook-section-folio--library" aria-hidden="true"><span>REFERANS DEFTERİ</span><span>NO. 03</span></div>
    <div class="library-home-grid">
      <a class="library-home-card library-home-feature notebook-library-feature" href="/atlas">
        <span class="notebook-card-bookmark" aria-hidden="true"></span>
        <span class="library-home-top"><small>01 / BİLEŞENLER</small><span aria-hidden="true">↗</span></span>
        <span class="library-home-symbol" aria-hidden="true">A—Z</span>
        <strong>Bileşen Atlası</strong>
        <span>{atlasCount} takviye ve dermokozmetik bileşeni. Mekanizma, klinik bağlam, güvenlilik, etkileşim ve etiket notları.</span>
        <span class="library-home-action">Atlası incele ↗</span>
      </a>
      <a class="library-home-card" href="/sozluk">
        <span class="library-home-top"><small>02 / REFERANS</small><span aria-hidden="true">↗</span></span>
        <strong>Eczacılık Sözlüğü</strong><span>{glossaryCount} terimlik kavram arşivi. Kısa tanımlar ve bağlantılı okumalar.</span>
        <span class="library-home-action">Terimleri keşfet ↗</span>
      </a>
      <a class="library-home-card" href="/etiket-rehberi">
        <span class="library-home-top"><small>03 / UYGULAMA</small><span aria-hidden="true">↗</span></span>
        <strong>Etiket Okuma Rehberi</strong><span>EPA+DHA, elementel mineral, CFU ve SPF gibi ifadeleri örneklerle çözün.</span>
        <span class="library-home-action">Rehberleri aç ↗</span>
      </a>
    </div>
  </section>

  <section class="shell hc-home" aria-labelledby="hc-home-title">
    <div class="journal-section-heading">
      <div><span class="journal-eyebrow">ECZACI DEFTERİ / UYGULAMALI</span><h2 id="hc-home-title">Sağlık Araçları</h2></div>
      <a href="/araclar">Tüm araçlar ↗</a>
    </div>
    <p class="hc-home-lead">Bilgiyi hesaplamalarla destekleyin. Her aracın yanında yöntemi, bilimsel kaynağı ve klinik yorum sınırları var.</p>
    <div class="hc-home-row">
      <a href="/araclar/vucut-kitle-indeksi"><span>01 / DSÖ</span><strong>Vücut Kitle İndeksi</strong><small>VKİ hesaplama ↗</small></a>
      <a href="/araclar/bel-boy-orani"><span>02 / NICE</span><strong>Bel / Boy Oranı</strong><small>Santral adiposite ↗</small></a>
      <a href="/araclar/bazal-metabolizma"><span>03 / FAO · DSÖ · UNU</span><strong>Bazal Metabolizma</strong><small>Enerji tahmini ↗</small></a>
    </div>
  </section>

  <section class="shell journal-latest">
    <div class="journal-section-heading">
      <div><span class="journal-eyebrow">ARŞİVDEN</span><h2>Son yazılar</h2></div>
      <a href="/yazilar">Bütün yazıları gör <span aria-hidden="true">↗</span></a>
    </div>
    {morePosts.length > 0 ? <div class="grid journal-post-grid">{morePosts.map(p => <PostCard post={p} />)}</div> : (
      <p>Yeni yazılar yayımlandıkça burada yer alacak.</p>
    )}
  </section>

  <section class="shell journal-manifesto">
    <div><span class="journal-eyebrow">ECZACININ NOT DEFTERİ</span><h2>Merakla başlar.<br/>Kaynakla devam eder.</h2></div>
    <div><p>Bu yayında bir içeriğin ne işe yaradığını, ne zaman kullanılabileceğini ve bilimsel araştırmalarda ne kadar destek bulduğunu birlikte değerlendiriyoruz.</p><p>Amacımız bilgi kalabalığını artırmak değil, konuya hakim olmak isteyen okura anlaşılır ve kaynaklı bir yol açmak.</p><a href="/hakkinda">Yayın ilkelerimiz ve yazar hakkında ↗</a></div>
  </section>
</Base>
