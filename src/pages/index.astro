---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', p => !p.data.draft))
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const categories = (await getCollection('categories'))
  .sort((a,b) => (a.data.order ?? 100) - (b.data.order ?? 100) || a.data.name.localeCompare(b.data.name,'tr'));
const topCategories = categories.filter(c => !c.data.parent);
const featured = posts.find(p => p.data.featured) ?? posts[0];
const latest = posts.filter(p => p.id !== featured?.id);
const leadAside = latest.slice(0,2);
const morePosts = latest.slice(2,11);
const slugOf = p => p.id.replace(/\.mdoc$/, '');
const catLabel = p => categories.find(c => c.id.replace(/\.json$/,'').split('/').pop() === p.data.category)?.data.name || p.data.category.replaceAll('-',' ');
const dateLabel = p => new Intl.DateTimeFormat('tr-TR',{day:'numeric',month:'long',year:'numeric'}).format(p.data.publishedAt);
---

<Base
  title="Eczacı Defteri | Eczacılık, Takviyeler ve Dermokozmetik"
  description="Eczacılık, takviye edici gıdalar, dermokozmetik ve sağlık üzerine kaynaklı değerlendirmeler. Eczacı Defteri'nde bilgiyi kanıtıyla okuyun."
>
  <header class="shell journal-intro">
    <div class="journal-intro-label"><span class="journal-signet" aria-hidden="true">ED</span><span>BAĞIMSIZ ECZACILIK YAYINI</span></div>
    <h1>Sağlık bilgisini <em>kaynağından</em> okuyun.</h1>
    <p>İlaçları, takviyeleri ve cilt bakımını; kullanım alanları, bilimsel kanıtlar ve eczacılık pratiği üzerinden ele alan bir not defteri.</p>
  </header>

  {featured && (
    <section class="shell journal-lead" aria-label="Öne çıkan ve yeni yazılar">
      <a class="journal-lead-story" href={'/yazi/' + slugOf(featured)}>
        <div class="journal-lead-image">
          {featured.data.coverImage
            ? <img src={featured.data.coverImage} alt="" width="1200" height="675" loading="eager" decoding="async" fetchpriority="high" />
            : <div class="journal-lead-fallback" aria-hidden="true">ECZACI DEFTERİ / DOSYA</div>}
        </div>
        <div class="journal-lead-caption">
          <span class="journal-eyebrow">ÖNE ÇIKAN YAZI <span class="journal-bullet">·</span> {catLabel(featured)}</span>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.excerpt}</p>
          <div class="journal-story-meta"><span>{dateLabel(featured)}</span><span>{featured.data.readingTime} dakika okuma</span><span class="journal-read-arrow">Yazıyı oku ↗</span></div>
        </div>
      </a>
      <aside class="journal-lead-aside" aria-label="Yeni yazılar">
        <div class="journal-aside-heading"><span>YENİ YAZILAR</span><a href="/yazilar">Tümü ↗</a></div>
        {leadAside.map((post,i) => (
          <a href={'/yazi/' + slugOf(post)} class="journal-aside-story">
            <span class="journal-aside-number">0{i+1}</span>
            <span class="journal-aside-copy"><small>{catLabel(post)} / {post.data.readingTime} dk</small><strong>{post.data.title}</strong><span>{post.data.excerpt}</span></span>
          </a>
        ))}
        <div class="journal-aside-signoff"><span class="journal-signet" aria-hidden="true">ED</span><p>Kaynağı gösteren, karşılaştıran ve anlaşılır kılan içerikler.</p></div>
      </aside>
    </section>
  )}

  <section class="shell journal-topics" aria-labelledby="journal-topics-title">
    <div class="journal-section-heading journal-topics-heading">
      <div><span class="journal-eyebrow">ECZACI DEFTERİ / KEŞFET</span><h2 id="journal-topics-title">Konular</h2></div>
      <span class="journal-topics-aside">Merak ettiğiniz alandan başlayın.</span>
    </div>
    <div class="journal-topics-grid">
      {topCategories.map((cat, index) => {
        const slug=cat.id.replace(/\.json$/,'').split('/').pop();
        const childSlugs=categories.filter(c=>c.data.parent===slug).map(c=>c.id.replace(/\.json$/,'').split('/').pop());
        const count=posts.filter(p=>p.data.category===slug||childSlugs.includes(p.data.category)).length;
        return <a class="journal-topic" href={'/kategori/'+slug}>
          <span class="journal-topic-top"><span>{String(index+1).padStart(2,'0')}</span><span>{count} yazı</span></span>
          <strong>{cat.data.name}</strong>
          <p>{cat.data.description}</p>
          <span class="journal-topic-foot">Konuyu keşfet <span aria-hidden="true">↗</span></span>
        </a>;
      })}
    </div>
    <a class="journal-glossary-link" href="/sozluk">
      <span class="journal-glossary-monogram" aria-hidden="true">A–Z</span>
      <span class="journal-glossary-copy">
        <small>YENİ / REFERANS</small>
        <strong>Eczacılık Sözlüğü</strong>
        <span>İlaç ve sağlık terimlerini kısa, anlaşılır ve kaynaklı tanımlarıyla keşfedin.</span>
      </span>
      <span class="journal-glossary-arrow" aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="shell journal-latest">
    <div class="journal-section-heading">
      <div><span class="journal-eyebrow">ARŞİVDEN</span><h2>Son yazılar</h2></div>
      <a href="/yazilar">Bütün yazıları gör <span aria-hidden="true">↗</span></a>
    </div>
    {morePosts.length > 0 ? <div class="grid journal-post-grid">{morePosts.map(p => <PostCard post={p} />)}</div> : (
      <p>Yeni yazılar yayımlandıkça burada yer alacak.</p>
    )}
  </section>

  <section class="shell journal-manifesto">
    <div><span class="journal-eyebrow">ECZACININ NOT DEFTERİ</span><h2>Merakla başlar.<br/>Kaynakla devam eder.</h2></div>
    <div><p>Bu yayında bir içeriğin ne işe yaradığını, ne zaman kullanılabileceğini ve bilimsel araştırmalarda ne kadar destek bulduğunu birlikte değerlendiriyoruz.</p><p>Amacımız bilgi kalabalığını artırmak değil, konuya hakim olmak isteyen okura anlaşılır ve kaynaklı bir yol açmak.</p><a href="/hakkinda">Yayın ilkelerimiz ve yazar hakkında ↗</a></div>
  </section>
</Base>
