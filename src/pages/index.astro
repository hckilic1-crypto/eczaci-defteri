---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (
  await getCollection('posts', (post) => post.data.status === 'published')
).sort(
  (a, b) =>
    b.data.publishedAt.valueOf() -
    a.data.publishedAt.valueOf()
);

const categories = (
  await getCollection('categories')
).sort((a, b) =>
  (a.data.order ?? 100) - (b.data.order ?? 100) ||
  a.data.name.localeCompare(b.data.name, 'tr')
);

const topCategories = categories.filter((category) => !category.data.parent);
const childrenFor = (parent) => categories.filter((category) => category.data.parent === parent.id.replace(/\.json$/, ''));

const featured =
  posts.find((post) => post.data.featured) ?? posts[0];

const rest = posts
  .filter((post) => post.id !== featured?.id)
  .slice(0, 5);
---

<Base
  title="Eczacı Defteri"
  description="Takviye edici gıdalar, dermokozmetik ürünler ve eczacılık pratiği üzerine kaynak odaklı içerikler."
>

  <section class="shell hero">

    <div class="hero-content">

      <div class="kicker">
        ECZACININ NOT DEFTERİ
      </div>

      <h1>
        Bilgiyi<br />
        kanıtıyla oku.
      </h1>

      <p>
        Takviye edici gıdaları, dermokozmetik ürünleri ve
        eczacılık pratiğini; içerik, etkinlik, güvenlilik
        ve güncel bilimsel veriler üzerinden ele alan
        bağımsız içerikler.
      </p>

      <div class="hero-actions">

        <a class="primary-button" href="/yazilar">
          Son yazıları keşfet
          <span>→</span>
        </a>

      </div>

    </div>

    <div class="editorial-note">

      <div class="editorial-number">
        01 / DEFTER
      </div>

      <div>

        <span class="editorial-small">
          EDİTORYAL YAKLAŞIM
        </span>

        <h2>
          Etiketten önce<br />
          içeriğe bak.
        </h2>

        <p>
          Ürünlerin pazarlama söylemlerinden çok;
          içeriklerini, dozlarını, kullanım biçimlerini,
          olası risklerini ve mevcut bilimsel kanıtları
          değerlendirmeye çalışıyoruz.
        </p>

      </div>

    </div>

  </section>


  <section class="shell category-strip">

    {topCategories.map((category) => (
      <div class="category-mini">
        <span class="category-accent" style={`background:${category.data.accent}`}></span>
        <div>
          <a href={`/kategori/${category.id.replace('.json', '')}`} class="category-mini-title">
            <strong>{category.data.name}</strong>
          </a>
          <p>{category.data.description}</p>
          {childrenFor(category).length > 0 && (
            <nav class="category-mini-children" aria-label={`${category.data.name} alt kategorileri`}>
              {childrenFor(category).map((child) => (
                <a href={`/kategori/${child.id.replace('.json', '')}`}>{child.data.name}</a>
              ))}
            </nav>
          )}
        </div>
        <a class="category-arrow" href={`/kategori/${category.id.replace('.json', '')}`} aria-label={`${category.data.name} kategorisini aç`}>↗</a>
      </div>
    ))}

  </section>


  <section class="shell">

    <div class="section-head">

      <div>

        <span class="section-eyebrow">
          YENİ EKLENENLER
        </span>

        <h2>
          Son yazılar
        </h2>

      </div>

      <a href="/yazilar">
        Tüm yazıları gör →
      </a>

    </div>

    <div class="grid">

      {featured && (
        <PostCard
          post={featured}
          featured
        />
      )}

      {rest.map((post) => (
        <PostCard post={post} />
      ))}

    </div>

  </section>


  <section class="shell about-strip">

    <div>

      <span class="section-eyebrow">
        ECZACI DEFTERİ
      </span>

      <h2>
        Ürün değil,<br />
        bilgi merkezde.
      </h2>

    </div>

    <div>

      <p>
        Bir ürünün popüler olması etkili olduğu anlamına gelmez.
        Bir içeriğin doğal olması da otomatik olarak güvenli olduğu
        anlamına gelmez.
      </p>

      <p>
        Buradaki içeriklerin amacı; takviye ve dermokozmetik
        alanındaki bilgileri daha anlaşılır, sorgulanabilir
        ve kaynak kontrollü hale getirmek.
      </p>

      <a href="/hakkinda">
        Editoryal yaklaşımı oku →
      </a>

    </div>

  </section>

</Base>
<style>
  .category-mini-title { color: inherit; display: inline-block; }
  .category-mini-children { display: flex; flex-wrap: wrap; gap: 7px 13px; margin-top: 12px; }
  .category-mini-children a { color: #366045; font-size: 11px; text-decoration: underline; text-decoration-color: #c5d2c5; text-underline-offset: 3px; }
  .category-mini-children a:hover { color: #102b1c; }
</style>
