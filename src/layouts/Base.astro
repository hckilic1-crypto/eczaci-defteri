---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const {
  title = 'Eczacı Defteri',
  description = 'Takviye, dermokozmetik ve eczacılık pratiği üzerine kaynak odaklı içerikler.',
  image = '/og-default.gif',
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  structuredData
} = Astro.props;


/* =========================================================
   SITE SETTINGS
========================================================= */

const settingsCollection = await getCollection('settings');
const settings = settingsCollection[0]?.data;

const siteName =
  settings?.siteName ??
  'Eczacı Defteri';


/* =========================================================
   CATEGORIES
========================================================= */

const categories = (
  await getCollection('categories')
).sort((a, b) =>
  (a.data.order ?? 100) - (b.data.order ?? 100) ||
  a.data.name.localeCompare(b.data.name, 'tr')
);

const topCategories = categories.filter(
  (category) => !category.data.parent
);

const getChildren = (slug: string) =>
  categories.filter(
    (category) =>
      category.data.parent === slug
  );

const categorySlug = (category: any) =>
  category.id
    .replace('.json', '')
    .replace(/\\/g, '/')
    .split('/')
    .pop();


/* =========================================================
   SEARCH DATA
========================================================= */

const allPosts = await getCollection(
  'posts',
  (post) => !post.data.draft
);

const searchPosts = allPosts.map((post) => {
  const postSlug = post.id
    .replace('.mdoc', '')
    .replace(/\\/g, '/')
    .split('/')
    .pop();

  const category = categories.find(
    (item) =>
      categorySlug(item) === post.data.category
  );

  return {
    title: post.data.title,
    excerpt: post.data.excerpt,
    category:
      category?.data.name ??
      post.data.category,
    href: `/yazi/${postSlug}`
  };
});

const searchData =
  JSON.stringify(searchPosts);


/* =========================================================
   SEO
========================================================= */

const canonical =
  Astro.site
    ? new URL(
        Astro.url.pathname,
        Astro.site
      ).toString()
    : Astro.url.toString();

const absoluteImage = new URL(
  image,
  Astro.site ?? Astro.url.origin
).toString();
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>

<html lang="tr">

<head>

  <meta name="google-site-verification" content="9JfYP8GbSiTwJUASlqx8RozZYHSKXTaUPC_94eEx420" />

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content={noindex ? "noindex,follow" : "index,follow"}
  />

  <meta
    name="theme-color"
    content="#f7f4ea"
  />


  <!-- =====================================================
       CANONICAL / SITEMAP / FAVICON
  ====================================================== -->

  <link
    rel="canonical"
    href={canonical}
  />

  <link
    rel="sitemap"
    href="/sitemap-index.xml"
  />

  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />


  <!-- =====================================================
       OPEN GRAPH
  ====================================================== -->

  <meta
    property="og:locale"
    content="tr_TR"
  />

  <meta
    property="og:type"
    content={type}
  />

  <meta
    property="og:site_name"
    content={siteName}
  />

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:url"
    content={canonical}
  />

  <meta
    property="og:image"
    content={absoluteImage}
  />

  <meta
    property="og:image:width"
    content="1200"
  />

  <meta
    property="og:image:height"
    content="630"
  />


  <!-- =====================================================
       X / TWITTER
  ====================================================== -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content={absoluteImage}
  />


  <!-- =====================================================
       ARTICLE META
  ====================================================== -->

  {type === 'article' && publishedAt && (
    <meta
      property="article:published_time"
      content={publishedAt.toISOString()}
    />
  )}

  {type === 'article' && updatedAt && (
    <meta
      property="article:modified_time"
      content={updatedAt.toISOString()}
    />
  )}

  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

</head>


<body>


<!-- =======================================================
     HEADER
======================================================== -->

<header class="site-header">

  <div class="shell header-inner">


    <!-- LOGO -->

    <a
      href="/"
      class="brand"
      aria-label="Eczacı Defteri ana sayfa"
    >

      <svg
        class="brand-logo"
        viewBox="0 0 72 72"
        aria-hidden="true"
      >

        <path
          class="logo-book"
          d="M11 19c8 1 16 5 23 11v29c-7-6-15-10-23-11V19Z"
        />

        <path
          class="logo-book"
          d="M61 19c-8 1-16 5-23 11v29c7-6 15-10 23-11V19Z"
        />

        <path
          class="logo-stem"
          d="M36 28v31"
        />

        <path
          class="logo-leaf"
          d="M36 24c1-9 7-14 16-15-1 9-7 14-16 15Z"
        />

        <path
          class="logo-leaf"
          d="M35 23c-1-7-6-11-13-12 1 7 6 11 13 12Z"
        />

      </svg>

      <strong>
        {siteName}
      </strong>

    </a>



    <!-- ===================================================
         DESKTOP NAV
    ==================================================== -->

    <nav
      class="desktop-nav"
      aria-label="Ana menü"
    >

      <a href="/">
        Anasayfa
      </a>


      <!-- CATEGORIES -->

      <div class="desktop-dropdown">

        <button
          class="desktop-dropdown-trigger"
          type="button"
          aria-label="Kategorileri göster"
        >

          Kategoriler

          <svg
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path d="m6 8 4 4 4-4" />
          </svg>

        </button>


        <div class="desktop-dropdown-panel">

          <div class="dropdown-header">

            <span>
              KATEGORİLER
            </span>

            <p>
              Konulara göre içerikleri keşfet.
            </p>

          </div>


          <div class="dropdown-grid">

            {topCategories.map((category) => {
              const slug =
                categorySlug(category);

              const children =
                getChildren(slug);

              return (

                <div class="dropdown-category">

                  <a
                    class="dropdown-category-title"
                    href={`/kategori/${slug}`}
                  >

                    <span
                      class="dropdown-dot"
                      style={`background:${category.data.accent}`}
                    ></span>

                    <span>
                      {category.data.name}
                    </span>

                    <span class="dropdown-arrow">
                      →
                    </span>

                  </a>


                  {category.data.description && (

                    <p>
                      {category.data.description}
                    </p>

                  )}


                  {children.length > 0 && (

                    <div class="dropdown-children">

                      {children.map((child) => (

                        <a
                          href={`/kategori/${categorySlug(child)}`}
                        >
                          {child.data.name}
                        </a>

                      ))}

                    </div>

                  )}

                </div>

              );
            })}

          </div>

        </div>

      </div>


      <a href="/yazilar">
        Yazılar
      </a>

      <a href="/hakkinda">
        Hakkında
      </a>


      <!-- SEARCH BUTTON -->

      <button
        class="search-trigger"
        id="search-trigger"
        type="button"
        aria-label="Yazılarda ara"
      >

        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >

          <circle
            cx="11"
            cy="11"
            r="6.5"
          ></circle>

          <path
            d="m16 16 4 4"
          ></path>

        </svg>

      </button>


      <a href="/iletisim">
        İletişim
      </a>

    </nav>



    <!-- ===================================================
         MOBILE HAMBURGER
    ==================================================== -->

    <button
      class="mobile-menu-button"
      id="mobile-menu-button"
      type="button"
      aria-label="Menüyü aç"
      aria-expanded="false"
    >

      <span></span>
      <span></span>
      <span></span>

    </button>

  </div>



  <!-- =====================================================
       MOBILE MENU
  ====================================================== -->

  <div
    class="mobile-menu"
    id="mobile-menu"
  >

    <div class="mobile-menu-inner">


      <!-- MOBILE SEARCH -->

      <div class="mobile-search-wrap">

        <input
          id="mobile-search-input"
          type="search"
          placeholder="Yazılarda ara..."
          autocomplete="off"
          aria-label="Yazılarda ara"
        />


        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >

          <circle
            cx="11"
            cy="11"
            r="6.5"
          ></circle>

          <path
            d="m16 16 4 4"
          ></path>

        </svg>


        <div
          class="mobile-search-results"
          id="mobile-search-results"
        ></div>

      </div>



      <a
        href="/"
        class="mobile-main-link"
      >
        Anasayfa
      </a>



      <!-- MOBILE CATEGORIES -->

      <div class="mobile-category-wrapper">

        <button
          class="mobile-category-button"
          id="mobile-category-button"
          type="button"
          aria-expanded="false"
        >

          <span>
            Kategoriler
          </span>

          <svg
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path d="m6 8 4 4 4-4" />
          </svg>

        </button>


        <div
          class="mobile-categories"
          id="mobile-categories"
        >

          {topCategories.map((category) => {
            const slug =
              categorySlug(category);

            const children =
              getChildren(slug);

            return (

              <div class="mobile-category-group">

                <a
                  class="mobile-category-title"
                  href={`/kategori/${slug}`}
                >

                  <span
                    style={`background:${category.data.accent}`}
                  ></span>

                  {category.data.name}

                </a>


                {children.length > 0 && (

                  <div class="mobile-subcategories">

                    {children.map((child) => (

                      <a
                        href={`/kategori/${categorySlug(child)}`}
                      >
                        {child.data.name}
                      </a>

                    ))}

                  </div>

                )}

              </div>

            );
          })}

        </div>

      </div>


      <a
        href="/yazilar"
        class="mobile-main-link"
      >
        Yazılar
      </a>

      <a
        href="/hakkinda"
        class="mobile-main-link"
      >
        Hakkında
      </a>

      <a
        href="/iletisim"
        class="mobile-main-link"
      >
        İletişim
      </a>

    </div>

  </div>

</header>



<!-- =======================================================
     DESKTOP SEARCH OVERLAY
======================================================== -->

<div
  class="search-overlay"
  id="search-overlay"
  aria-hidden="true"
>

  <div
    class="search-modal"
    role="dialog"
    aria-modal="true"
    aria-label="Yazılarda ara"
  >

    <div class="search-modal-top">

      <span class="section-eyebrow">
        ECZACI DEFTERİ
      </span>


      <button
        class="search-close"
        id="search-close"
        type="button"
        aria-label="Aramayı kapat"
      >
        ×
      </button>

    </div>



    <div class="search-field-wrap">

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <circle
          cx="11"
          cy="11"
          r="6.5"
        ></circle>

        <path
          d="m16 16 4 4"
        ></path>

      </svg>


      <input
        id="search-input"
        type="search"
        placeholder="Ne arıyorsunuz?"
        autocomplete="off"
        aria-label="Arama"
      />

    </div>


    <div class="search-hint">
      Yazı başlığı, açıklama veya kategori ile arayın.
    </div>


    <div
      class="search-results"
      id="search-results"
    ></div>

  </div>

</div>



<!-- =======================================================
     PAGE
======================================================== -->

<main>

  <slot />

</main>



<!-- =======================================================
     FOOTER
======================================================== -->

<footer class="shell footer">

  <div class="footer-grid">

    <div>

      <a
        class="brand footer-brand"
        href="/"
      >

        <svg
          class="brand-logo brand-logo-small"
          viewBox="0 0 72 72"
          aria-hidden="true"
        >

          <path
            class="logo-book"
            d="M11 19c8 1 16 5 23 11v29c-7-6-15-10-23-11V19Z"
          />

          <path
            class="logo-book"
            d="M61 19c-8 1-16 5-23 11v29c7-6 15-10 23-11V19Z"
          />

          <path
            class="logo-stem"
            d="M36 28v31"
          />

          <path
            class="logo-leaf"
            d="M36 24c1-9 7-14 16-15-1 9-7 14-16 15Z"
          />

        </svg>


        <strong>
          {siteName}
        </strong>

      </a>


      <p>
        Takviye edici gıdalar, dermokozmetik ürünler ve
        eczacılık pratiği üzerine kaynak odaklı içerikler.
      </p>

    </div>


    <div>

      <p>
        İçerikler genel bilgilendirme amacıyla hazırlanır.
        Kişisel tanı ve tedavi önerisi yerine geçmez.
      </p>

      <p>
        © {new Date().getFullYear()} Eczacı Defteri
      </p>

    </div>

  </div>

</footer>



<!-- =======================================================
     MOBILE MENU SCRIPT
======================================================== -->

<script is:inline>

  const menuButton =
    document.getElementById(
      'mobile-menu-button'
    );

  const mobileMenu =
    document.getElementById(
      'mobile-menu'
    );

  const categoryButton =
    document.getElementById(
      'mobile-category-button'
    );

  const mobileCategories =
    document.getElementById(
      'mobile-categories'
    );


  menuButton?.addEventListener(
    'click',
    () => {

      const isOpen =
        mobileMenu?.classList.toggle(
          'is-open'
        );

      menuButton.classList.toggle(
        'is-open',
        Boolean(isOpen)
      );

      menuButton.setAttribute(
        'aria-expanded',
        String(Boolean(isOpen))
      );

      document.body.classList.toggle(
        'menu-open',
        Boolean(isOpen)
      );

    }
  );


  categoryButton?.addEventListener(
    'click',
    () => {

      const isOpen =
        mobileCategories?.classList.toggle(
          'is-open'
        );

      categoryButton.classList.toggle(
        'is-open',
        Boolean(isOpen)
      );

      categoryButton.setAttribute(
        'aria-expanded',
        String(Boolean(isOpen))
      );

    }
  );


  window.addEventListener(
    'resize',
    () => {

      if(
        window.innerWidth > 820
      ){

        mobileMenu?.classList.remove(
          'is-open'
        );

        menuButton?.classList.remove(
          'is-open'
        );

        menuButton?.setAttribute(
          'aria-expanded',
          'false'
        );

        document.body.classList.remove(
          'menu-open'
        );

      }

    }
  );

</script>



<!-- =======================================================
     SEARCH SCRIPT
======================================================== -->

<script
  is:inline
  define:vars={{ searchData }}
>

  const posts =
    JSON.parse(searchData);


  const normalizeText = (value) => {
    return String(value ?? '')
      .toLocaleLowerCase('tr-TR')
      .normalize('NFD')
      .replace(
        /[\u0300-\u036f]/g,
        ''
      );
  };


  const escapeHTML = (value) => {
    return String(value ?? '')
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#039;');
  };


  const filterPosts = (query) => {

    const search =
      normalizeText(
        query.trim()
      );

    if(!search){
      return [];
    }

    return posts
      .filter((post) => {

        const content =
          normalizeText(
            `${post.title} ${post.excerpt} ${post.category}`
          );

        return content.includes(
          search
        );

      })
      .slice(0,8);

  };


  const renderResults = (
    foundPosts,
    container
  ) => {

    if(!container){
      return;
    }

    if(!foundPosts.length){

      container.innerHTML = `
        <div class="search-empty">
          Sonuç bulunamadı.
        </div>
      `;

      return;
    }

    container.innerHTML =
      foundPosts
        .map((post) => {
          return `
            <a
              class="search-result-item"
              href="${escapeHTML(post.href)}"
            >
              <div>

                <span
                  class="search-result-category"
                >
                  ${escapeHTML(post.category)}
                </span>

                <strong>
                  ${escapeHTML(post.title)}
                </strong>

                <p>
                  ${escapeHTML(post.excerpt)}
                </p>

              </div>

              <span
                class="search-result-arrow"
              >
                →
              </span>

            </a>
          `;
        })
        .join('');

  };


  /* DESKTOP SEARCH */

  const searchTrigger =
    document.getElementById(
      'search-trigger'
    );

  const searchOverlay =
    document.getElementById(
      'search-overlay'
    );

  const searchClose =
    document.getElementById(
      'search-close'
    );

  const searchInput =
    document.getElementById(
      'search-input'
    );

  const searchResults =
    document.getElementById(
      'search-results'
    );


  const openSearch = () => {

    searchOverlay?.classList.add(
      'is-open'
    );

    searchOverlay?.setAttribute(
      'aria-hidden',
      'false'
    );

    document.body.classList.add(
      'search-open'
    );

    setTimeout(() => {
      searchInput?.focus();
    },50);

  };


  const closeSearch = () => {

    searchOverlay?.classList.remove(
      'is-open'
    );

    searchOverlay?.setAttribute(
      'aria-hidden',
      'true'
    );

    document.body.classList.remove(
      'search-open'
    );

    if(searchInput){
      searchInput.value = '';
    }

    if(searchResults){
      searchResults.innerHTML = '';
    }

  };


  searchTrigger?.addEventListener(
    'click',
    openSearch
  );

  searchClose?.addEventListener(
    'click',
    closeSearch
  );


  searchOverlay?.addEventListener(
    'click',
    (event) => {

      if(
        event.target ===
        searchOverlay
      ){
        closeSearch();
      }

    }
  );


  document.addEventListener(
    'keydown',
    (event) => {

      if(event.key === 'Escape'){
        closeSearch();
      }

    }
  );


  searchInput?.addEventListener(
    'input',
    (event) => {

      const target =
        event.target;

      const value =
        target instanceof HTMLInputElement
          ? target.value
          : '';

      if(!value.trim()){

        if(searchResults){
          searchResults.innerHTML = '';
        }

        return;
      }

      renderResults(
        filterPosts(value),
        searchResults
      );

    }
  );


  /* MOBILE SEARCH */

  const mobileSearchInput =
    document.getElementById(
      'mobile-search-input'
    );

  const mobileSearchResults =
    document.getElementById(
      'mobile-search-results'
    );


  mobileSearchInput?.addEventListener(
    'input',
    (event) => {

      const target =
        event.target;

      const value =
        target instanceof HTMLInputElement
          ? target.value
          : '';

      if(!value.trim()){

        if(mobileSearchResults){
          mobileSearchResults.innerHTML = '';
        }

        return;
      }

      renderResults(
        filterPosts(value),
        mobileSearchResults
      );

    }
  );

</script>


</body>

</html>