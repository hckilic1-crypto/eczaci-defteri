---
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/library.css';
import '../styles/notebook-motifs.css';
import '../styles/health-tools.css';
import '../styles/content-connections.css';
import '../styles/topic-hubs.css';
import '../styles/theme.css';
import { topicHubs } from '../lib/topic-hubs';
import { getCollection } from 'astro:content';

const {
  title = 'Eczacı Defteri',
  description = 'Takviye, dermokozmetik ve eczacılık pratiği üzerine kaynak odaklı içerikler.',
  image = '/og-default.gif',
  preloadImage = undefined,
  preloadImageSrcset = undefined,
  preloadImageSizes = undefined,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  structuredData
} = Astro.props;


/* =========================================================
   SITE SETTINGS
========================================================= */

const settingsCollection = await getCollection('settings');
const settings = settingsCollection[0]?.data;

const siteName =
  settings?.siteName ??
  'Eczacı Defteri';


/* =========================================================
   SEO
========================================================= */

const canonical =
  Astro.site
    ? new URL(
        Astro.url.pathname,
        Astro.site
      ).toString()
    : Astro.url.toString();

const absoluteImage = new URL(
  image,
  Astro.site ?? Astro.url.origin
).toString();
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>

<html lang="tr" data-theme="light">

<head>
  <meta charset="UTF-8" />
  <!-- Set saved choice before styles paint; first visit is always light. -->
  <script is:inline>
    try {
      if (localStorage.getItem('ed-theme') === 'dark') {
        document.documentElement.dataset.theme = 'dark';
      }
    } catch (_) { /* Light remains the default. */ }
  </script>

  <meta name="google-site-verification" content="9JfYP8GbSiTwJUASlqx8RozZYHSKXTaUPC_94eEx420" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content={noindex ? "noindex,follow" : "index,follow"}
  />

  <meta
    name="theme-color"
    content="#f7f4ea"
  />


  <!-- =====================================================
       CANONICAL / SITEMAP / FAVICON
  ====================================================== -->

  <!-- Early connections and font CSS; no blocking CSS @import waterfall. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" />
  {preloadImage && <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes} fetchpriority="high" />}

  <link
    rel="canonical"
    href={canonical}
  />

  <link
    rel="sitemap"
    href="/sitemap-index.xml"
  />

  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />


  <!-- =====================================================
       OPEN GRAPH
  ====================================================== -->

  <meta
    property="og:locale"
    content="tr_TR"
  />

  <meta
    property="og:type"
    content={type}
  />

  <meta
    property="og:site_name"
    content={siteName}
  />

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:url"
    content={canonical}
  />

  <meta
    property="og:image"
    content={absoluteImage}
  />

  <meta
    property="og:image:width"
    content="1200"
  />

  <meta
    property="og:image:height"
    content="630"
  />


  <!-- =====================================================
       X / TWITTER
  ====================================================== -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content={absoluteImage}
  />


  <!-- =====================================================
       ARTICLE META
  ====================================================== -->

  {type === 'article' && publishedAt && (
    <meta
      property="article:published_time"
      content={publishedAt.toISOString()}
    />
  )}

  {type === 'article' && updatedAt && (
    <meta
      property="article:modified_time"
      content={updatedAt.toISOString()}
    />
  )}

  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

</head>


<body>


<!-- =======================================================
     HEADER
======================================================== -->

<header class="site-header">

  <div class="shell header-inner">


    <!-- LOGO -->

    <a
      href="/"
      class="brand"
      aria-label="Eczacı Defteri ana sayfa"
    >

      <svg
        class="brand-logo"
        viewBox="0 0 72 72"
        aria-hidden="true"
      >

        <path
          class="logo-book"
          d="M11 19c8 1 16 5 23 11v29c-7-6-15-10-23-11V19Z"
        />

        <path
          class="logo-book"
          d="M61 19c-8 1-16 5-23 11v29c7-6 15-10 23-11V19Z"
        />

        <path
          class="logo-stem"
          d="M36 28v31"
        />

        <path
          class="logo-leaf"
          d="M36 24c1-9 7-14 16-15-1 9-7 14-16 15Z"
        />

        <path
          class="logo-leaf"
          d="M35 23c-1-7-6-11-13-12 1 7 6 11 13 12Z"
        />

      </svg>

      <strong>
        {siteName}
      </strong>

    </a>



    <!-- Simplified desktop navigation. Yazılar intentionally follows Anasayfa. -->
    <nav class="desktop-nav edf-nav" aria-label="Ana menü">
      <a href="/" aria-current={Astro.url.pathname==='/' ? 'page' : undefined}>Anasayfa</a>
      <a href="/yazilar" aria-current={Astro.url.pathname==='/yazilar' ? 'page' : undefined}>Yazılar</a>

      <details class="edf-flyout edf-flyout--topics">
        <summary aria-label="Konu merkezleri menüsünü aç">Konular
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7 5 5 5-5" /></svg>
        </summary>
        <div class="edf-flyout-panel">
          <div class="edf-flyout-intro"><span>ECZACI DEFTERİ / KEŞFET</span><strong>Konu merkezleri</strong><p>Bir sorudan başlayın; yazı, Atlas, sözlük ve rehberleri birlikte okuyun.</p></div>
          <div class="edf-flyout-topic-grid">
            {topicHubs.map(hub=><a href={'/konular/'+hub.slug}><small>{hub.mark} / KONU</small><strong>{hub.title}</strong><span>{hub.short}</span></a>)}
          </div>
          <a class="edf-flyout-all" href="/konular">Beş konu merkezinin tümü <span aria-hidden="true">↗</span></a>
        </div>
      </details>

      <details class="edf-flyout edf-flyout--library">
        <summary aria-label="Kütüphane menüsünü aç">Kütüphane
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7 5 5 5-5" /></svg>
        </summary>
        <div class="edf-flyout-panel">
          <div class="edf-flyout-intro"><span>ARAŞTIRMA / BAŞVURU</span><strong>Referans kütüphanesi</strong><p>Bileşen dosyaları, etiket örnekleri ve eczacılık kavramları.</p></div>
          <a class="edf-library-item" href="/atlas"><strong>Bileşen Atlası</strong><small>Etki mekanizması ve güvenlilik <span aria-hidden="true">↗</span></small></a>
          <a class="edf-library-item" href="/etiket-rehberi"><strong>Etiket Okuma Rehberi</strong><small>Porsiyon, birim ve içerik analizi <span aria-hidden="true">↗</span></small></a>
          <a class="edf-library-item" href="/sozluk"><strong>Eczacılık Sözlüğü</strong><small>Kavramlar ve bağlantılı okumalar <span aria-hidden="true">↗</span></small></a>
        </div>
      </details>

      <a href="/araclar">Araçlar</a>
      <a href="/hakkinda">Hakkında</a>
      <a href="/iletisim">İletişim</a>
      <button class="search-trigger" id="search-trigger" type="button" aria-label="Sitede ara">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
      </button>
    </nav>

    <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Koyu temaya geç" aria-pressed="false" title="Koyu temaya geç">
        <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 15.7A8.8 8.8 0 0 1 8.3 3.7a8.8 8.8 0 1 0 12 12Z"/></svg>
        <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>

    <!-- ===================================================
         MOBILE HAMBURGER
    ==================================================== -->

    <button
      class="mobile-menu-button"
      id="mobile-menu-button"
      type="button"
      aria-label="Menüyü aç"
      aria-expanded="false"
    >

      <span></span>
      <span></span>
      <span></span>

    </button>

  </div>



  <!-- =====================================================
       MOBILE MENU
  ====================================================== -->

  <div
    class="mobile-menu"
    id="mobile-menu"
  >

    <div class="mobile-menu-inner">


      <!-- MOBILE SEARCH -->

      <div class="mobile-search-wrap">

        <input
          id="mobile-search-input"
          type="search"
          placeholder="Yazı veya terim ara..."
          autocomplete="off"
          aria-label="Yazılarda ara"
        />


        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >

          <circle
            cx="11"
            cy="11"
            r="6.5"
          ></circle>

          <path
            d="m16 16 4 4"
          ></path>

        </svg>


        <div
          class="mobile-search-results"
          id="mobile-search-results"
        ></div>

      </div>



      <a href="/" class="mobile-main-link">Anasayfa</a>
      <a href="/yazilar" class="mobile-main-link">Yazılar</a>

      <details class="edf-mobile-group">
        <summary>Konular <span aria-hidden="true">+</span></summary>
        <div class="edf-mobile-group-links">
          <a href="/konular" class="edf-mobile-all">Tüm konu merkezleri ↗</a>
          {topicHubs.map(hub=><a href={'/konular/'+hub.slug}><span>{hub.mark}</span>{hub.title}</a>)}
        </div>
      </details>

      <details class="edf-mobile-group">
        <summary>Kütüphane <span aria-hidden="true">+</span></summary>
        <div class="edf-mobile-group-links">
          <a href="/atlas"><span>01</span>Bileşen Atlası</a>
          <a href="/etiket-rehberi"><span>02</span>Etiket Okuma Rehberi</a>
          <a href="/sozluk"><span>03</span>Eczacılık Sözlüğü</a>
        </div>
      </details>

      <a href="/araclar" class="mobile-main-link">Sağlık Araçları</a>
      <a href="/hakkinda" class="mobile-main-link">Hakkında</a>
      <a href="/iletisim" class="mobile-main-link">İletişim</a>

    </div>

  </div>

</header>



<!-- =======================================================
     DESKTOP SEARCH OVERLAY
======================================================== -->

<div
  class="search-overlay"
  id="search-overlay"
  aria-hidden="true"
>

  <div
    class="search-modal"
    role="dialog"
    aria-modal="true"
    aria-label="Yazılarda ara"
  >

    <div class="search-modal-top">

      <span class="section-eyebrow">
        ECZACI DEFTERİ
      </span>


      <button
        class="search-close"
        id="search-close"
        type="button"
        aria-label="Aramayı kapat"
      >
        ×
      </button>

    </div>



    <div class="search-field-wrap">

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <circle
          cx="11"
          cy="11"
          r="6.5"
        ></circle>

        <path
          d="m16 16 4 4"
        ></path>

      </svg>


      <input
        id="search-input"
        type="search"
        placeholder="Ne arıyorsunuz?"
        autocomplete="off"
        aria-label="Arama"
      />

    </div>


    <div class="search-hint">
      Yazı, eczacılık terimi veya kategori ile arayın.
    </div>


    <div
      class="search-results"
      id="search-results"
    ></div>

  </div>

</div>



<!-- =======================================================
     PAGE
======================================================== -->

<main>

  <slot />

</main>



<!-- =======================================================
     FOOTER
======================================================== -->

<footer class="shell footer">

  <div class="footer-grid">

    <div>

      <a
        class="brand footer-brand"
        href="/"
      >

        <svg
          class="brand-logo brand-logo-small"
          viewBox="0 0 72 72"
          aria-hidden="true"
        >

          <path
            class="logo-book"
            d="M11 19c8 1 16 5 23 11v29c-7-6-15-10-23-11V19Z"
          />

          <path
            class="logo-book"
            d="M61 19c-8 1-16 5-23 11v29c7-6 15-10 23-11V19Z"
          />

          <path
            class="logo-stem"
            d="M36 28v31"
          />

          <path
            class="logo-leaf"
            d="M36 24c1-9 7-14 16-15-1 9-7 14-16 15Z"
          />

        </svg>


        <strong>
          {siteName}
        </strong>

      </a>


      <p>
        Takviye edici gıdalar, dermokozmetik ürünler ve
        eczacılık pratiği üzerine kaynak odaklı içerikler.
      </p>

      <nav class="journal-footer-links" aria-label="Alt menü"><a href="/yazilar">Yazılar</a><a href="/konular">Konu Merkezleri</a><a href="/sozluk">Eczacılık Sözlüğü</a><a href="/atlas">Bileşen Atlası</a><a href="/etiket-rehberi">Etiket Rehberi</a><a href="/araclar">Sağlık Araçları</a><a href="/hakkinda">Hakkında</a></nav>

    </div>


    <div>

      <p>
        İçerikler genel bilgilendirme amacıyla hazırlanır.
        Kişisel tanı ve tedavi önerisi yerine geçmez.
      </p>

      <p>
        © {new Date().getFullYear()} Eczacı Defteri
      </p>

    </div>

  </div>

</footer>



<!-- Visitor theme: light by default; saved choice persists across visits. -->


<!-- Accessible navigation: native details controls + Escape/outside-click closing. -->


<!-- =======================================================
     SEARCH SCRIPT
======================================================== -->




<script src="/site-interactions.js?v=1" defer></script>

</body>

</html>