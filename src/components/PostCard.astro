---
import { getCollection } from 'astro:content';
const { post, featured = false } = Astro.props;
const d = post.data;
const slug = post.id.replace(/\.mdoc$/, '');
const cats = await getCollection('categories');
const categoryName = cats.find(c => c.id.replace(/\.json$/, '') === d.category)?.data.name ?? d.category.replaceAll('-', ' ');
---
<a class:list={['card', {featured}]} href={`/yazi/${slug}`} data-category={d.category} data-search={`${d.title} ${d.excerpt} ${categoryName}`}>
  <div class="meta"><span class="dot"></span><span>{categoryName}</span><span>·</span><span>{d.readingTime} dk</span></div>
  <h3>{d.title}</h3><p>{d.excerpt}</p><div class="arrow">↗</div>
</a>
