---
type Mode = 'bmi' | 'waist' | 'energy';
interface Props { mode: Mode }
const { mode } = Astro.props;
---
<section class="hc-panel health-calc" data-calculator={mode} aria-label="Sağlık hesaplayıcısı">
  <div class="hc-panel-heading">
    <span class="hc-index">UYGULAMALI ARAÇ / {mode === 'bmi' ? '01' : mode === 'waist' ? '02' : '03'}</span>
    <span class="hc-private">Verileriniz tarayıcıda hesaplanır, sunucuya gönderilmez.</span>
  </div>

  <form class="hc-form" novalidate>
    <div class="hc-fields">
      {mode === 'energy' && (
        <>
          <label class="hc-field">Yaş <span>yıl</span>
            <input name="age" type="number" min="18" max="100" step="1" inputmode="numeric" placeholder="30" required />
          </label>
          <label class="hc-field">Formüldeki biyolojik cinsiyet kategorisi
            <select name="sex" required>
              <option value="">Seçiniz</option>
              <option value="male">Erkek</option>
              <option value="female">Kadın</option>
            </select>
          </label>
        </>
      )}
      {mode !== 'energy' && (
        <label class="hc-field">Boy <span>cm</span>
          <input name="height" type="number" min="110" max="230" step="0.1" inputmode="decimal" placeholder="175" required />
        </label>
      )}
      {mode !== 'waist' && (
        <label class="hc-field">Vücut ağırlığı <span>kg</span>
          <input name="weight" type="number" min="25" max="350" step="0.1" inputmode="decimal" placeholder="75" required />
        </label>
      )}
      {mode === 'waist' && (
        <label class="hc-field">Bel çevresi <span>cm</span>
          <input name="waist" type="number" min="30" max="250" step="0.1" inputmode="decimal" placeholder="85" required />
        </label>
      )}
      {mode === 'energy' && (
        <label class="hc-field hc-field-wide">Günlük hareket düzeyi
          <select name="activity" required>
            <option value="">Aktivite düzeyini seçin</option>
            <option value="light">Hareketsiz / hafif aktif (PAL 1,40–1,69)</option>
            <option value="moderate">Orta düzeyde aktif (PAL 1,70–1,99)</option>
            <option value="vigorous">Çok aktif (PAL 2,00–2,40)</option>
          </select>
        </label>
      )}
    </div>
    <div class="hc-actions">
      <button class="hc-submit" type="submit">Hesapla <span aria-hidden="true">↗</span></button>
      <button class="hc-clear" type="reset">Temizle</button>
    </div>
    <p class="hc-error" data-error role="alert" hidden>Lütfen geçerli değerler girin.</p>
  </form>

  <div class="hc-result" data-result hidden aria-live="polite" aria-atomic="true">
    <span class="hc-result-label">{mode === 'bmi' ? 'DSÖ / YETİŞKİN VÜCUT KİTLE İNDEKSİ' : mode === 'waist' ? 'NICE / BEL – BOY ORANI' : 'FAO/WHO/UNU / TAHMİNİ BAZAL METABOLİZMA'}</span>
    <div class="hc-result-main">
      <strong data-value>—</strong>
      <span class="hc-unit" data-unit>{mode === 'energy' ? 'kcal/gün' : mode === 'bmi' ? 'kg/m²' : 'oran'}</span>
    </div>
    <p class="hc-result-category" data-category></p>
    <p class="hc-result-note" data-note></p>
    {mode === 'bmi' && (
      <div class="hc-meter-wrap">
        <div class="hc-meter-labels"><span>18,5</span><span>25</span><span>30</span><span>40+</span></div>
        <div class="hc-meter" aria-hidden="true"><span class="hc-meter-marker" data-marker></span></div>
        <p class="hc-result-extra" data-extra></p>
      </div>
    )}
    {mode === 'energy' && (
      <div class="hc-energy-extra">
        <span>FAO/WHO/UNU PAL aralığıyla tahmini toplam günlük enerji gereksinimi</span>
        <strong data-extra>—</strong>
        <small>Bu, beslenme reçetesi veya kişiye özel enerji hedefi değildir.</small>
      </div>
    )}
    {mode === 'waist' && <p class="hc-result-extra" data-extra></p>}
  </div>
  <p class="hc-method">{mode === 'bmi' ? 'Formül: VKİ = ağırlık (kg) / [boy (m)]².' : mode === 'waist' ? 'Formül: bel çevresi (cm) / boy (cm).' : 'FAO/WHO/UNU (2004): Schofield denklemiyle yaş ve biyolojik cinsiyet kategorisine göre kilo temelli BMR tahmini (kcal/gün). Günlük toplam enerji tahmini = BMR × PAL.'} </p>
</section>

<script>
  const format = (x: number, digits = 1) => x.toLocaleString('tr-TR', { maximumFractionDigits: digits, minimumFractionDigits: digits });
  const bounds: Record<string, [number, number]> = {
    age:[18,100], height:[110,230], weight:[25,350], waist:[30,250]
  };
  const readNumber = (form: HTMLFormElement, name: string) => {
    const el = form.elements.namedItem(name) as HTMLInputElement | null;
    const raw = el?.value.trim() ?? '';
    if (!raw) return NaN;
    return Number(raw.replace(',', '.'));
  };
  const valid = (name:string, value:number) => {
    const [min,max] = bounds[name];
    return Number.isFinite(value) && value >= min && value <= max;
  };
  document.querySelectorAll<HTMLElement>('.health-calc').forEach(root => {
    const form = root.querySelector<HTMLFormElement>('form');
    const result = root.querySelector<HTMLElement>('[data-result]');
    const error = root.querySelector<HTMLElement>('[data-error]');
    const value = root.querySelector<HTMLElement>('[data-value]');
    const category = root.querySelector<HTMLElement>('[data-category]');
    const note = root.querySelector<HTMLElement>('[data-note]');
    const extra = root.querySelector<HTMLElement>('[data-extra]');
    if (!form || !result || !error || !value || !category || !note) return;
    const resetOutput = () => { result.hidden = true; error.hidden = true; };
    form.addEventListener('input', resetOutput);
    form.addEventListener('change', resetOutput);
    form.addEventListener('reset', resetOutput);
    form.addEventListener('submit', event => {
      event.preventDefault();
      error.hidden = true;
      const height = readNumber(form,'height');
      const mode = root.dataset.calculator;
      const weight = mode !== 'waist' ? readNumber(form,'weight') : NaN;
      const waist = mode === 'waist' ? readNumber(form,'waist') : NaN;
      const age = mode === 'energy' ? readNumber(form,'age') : NaN;
      const sex = (form.elements.namedItem('sex') as HTMLSelectElement | null)?.value;
      const activity = (form.elements.namedItem('activity') as HTMLSelectElement | null)?.value;
      const palRanges: Record<string,[number,number]> = {
        light: [1.40,1.69],
        moderate: [1.70,1.99],
        vigorous: [2.00,2.40]
      };
      const okay = (mode === 'energy' || valid('height',height)) &&
        (mode === 'waist' ? valid('waist',waist) : valid('weight',weight)) &&
        (mode !== 'energy' || (valid('age',age) && Number.isInteger(age) &&
          (sex === 'male' || sex === 'female') &&
          !!activity && activity in palRanges));
      if (!okay) {
        result.hidden = true;
        error.hidden = false;
        error.textContent = 'Lütfen tüm alanları belirtilen aralıklarda doldurun.';
        return;
      }
      if (mode === 'bmi') {
        const bmi = weight / Math.pow(height/100,2);
        const status = bmi < 16 ? 'İleri düzeyde zayıflık (DSÖ)' :
          bmi < 17 ? 'Orta düzeyde zayıflık (DSÖ)' :
          bmi < 18.5 ? 'Hafif düzeyde zayıflık (DSÖ)' :
          bmi < 25 ? 'Normal aralık (DSÖ)' :
          bmi < 30 ? 'Fazla kilolu (DSÖ)' :
          bmi < 35 ? 'Obezite sınıf I (DSÖ)' :
          bmi < 40 ? 'Obezite sınıf II (DSÖ)' : 'Obezite sınıf III (DSÖ)';
        value.textContent = format(bmi);
        category.textContent = status;
        note.textContent = 'DSÖ yetişkin VKİ eşikleri kullanılmıştır. VKİ yağ dağılımını veya kas kütlesini ölçmez; tek başına hastalık tanısı koydurmaz.';
        if (extra) extra.textContent = 'Boyunuza göre VKİ 18,5–24,9 aralığının matematiksel karşılığı: ' +
          format(18.5 * (height/100)**2) + '–' + format(24.9*(height/100)**2) + ' kg. Bu aralık kişisel kilo hedefi değildir.';
        const needle = root.querySelector<HTMLElement>('[data-marker]');
        if (needle) needle.style.left = Math.max(0,Math.min(100,(bmi-15)/30*100)) + '%';
      } else if (mode === 'waist') {
        const ratio = waist/height;
        value.textContent = format(ratio,2);
        category.textContent = ratio < .4 ? 'NICE sınıflama aralığının altında' :
          ratio < .5 ? 'Belirgin santral adiposite artışı sınıfında değil' :
          ratio < .6 ? 'Artmış santral adiposite' : 'Yüksek santral adiposite';
        note.textContent = 'NICE ölçütleri özellikle VKİ 35 kg/m² altında olan yetişkinlerde yorumlanır. Tek ölçüm tanı koydurmaz.';
        if (extra) extra.textContent = 'Boyunuzun yarısı ' + format(height/2) +
          ' cm. NICE, bel çevresini boyun yarısından düşük tutmayı önerir; bu kişisel tedavi hedefi değildir.';
      } else if (mode === 'energy') {
        // Schofield weight-only BMR equations as retained in FAO/WHO/UNU (2004), Table 5.2.
        // Age groups: 18–29, 30–59, 60+.
        const ageGroup = age < 30 ? 0 : age < 60 ? 1 : 2;
        const equations: Record<string, [number,number][]> = {
          male: [[15.057,692.2],[11.472,873.1],[11.711,587.7]],
          female: [[14.818,486.6],[8.126,845.6],[9.082,658.5]]
        };
        const [coefficient,constant] = equations[sex!][ageGroup];
        const bmr = coefficient*weight + constant;
        const [palMin,palMax] = palRanges[activity!];
        value.textContent = Math.round(bmr).toLocaleString('tr-TR');
        category.textContent = 'FAO/WHO/UNU – Schofield ile tahmini bazal metabolizma hızı (BMR)';
        note.textContent = 'Bu değer doğrudan metabolizma ölçümü değildir. PAL aralığı kişisel hareket düzeyinin ölçümü değil, kategori temelli bir varsayımdır.';
        if (extra) extra.textContent = Math.round(bmr*palMin).toLocaleString('tr-TR') +
          '–' + Math.round(bmr*palMax).toLocaleString('tr-TR') + ' kcal/gün';
      }
      result.hidden = false;
    });
  });
</script>
